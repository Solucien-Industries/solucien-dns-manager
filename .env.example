# ----------------------------------------------------------------------------
# Solucien DNS Manager — environment reference
#
# Copy values into the per-app env files (Next.js does not read this root file):
#   apps/web/.env.local   — Auth.js + OAuth + AUTH_EXCHANGE_SECRET
#   apps/api/.env         — JWT + AUTH_EXCHANGE_SECRET + database/redis/PowerDNS
# ----------------------------------------------------------------------------

# --- Auth.js (apps/web/.env.local) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_EXCHANGE_SECRET=

# --- Web -> API (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DOCS_URL=http://localhost:3001

# --- API (apps/api/.env) ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
AUTH_EXCHANGE_SECRET=wUgpkZA2ABArdrjenvRnKXuTsFTaWDt9xaPacQDT0Hc=
JWT_SECRET=ck/Ro+bJc1FTpHnIh4K+4Oa07w8D0c4BPURxxZzP7pM=
JWT_EXPIRES_IN=7d

# The only permanent platform admin (cross-tenant access). Other admins are
# granted via POST /admin/admins, which is itself restricted to admins.
PLATFORM_ADMIN_EMAIL=becky.malaak@solucien.co.ze

# --- PostgreSQL (Prisma) ---
DATABASE_URL=postgresql://sdm:sdm@localhost:5432/sdm?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- PowerDNS Authoritative HTTP API ---
PDNS_API_URL=http://localhost:8081
# Generate with: openssl rand -hex 24
PDNS_API_KEY=
PDNS_SERVER_ID=localhost

# --- Nani SMTP relay (apps/api/.env) ---
SMTP_RELAY_HOST=smtp.nani.dns
SMTP_RELAY_PORT=587
SMTP_RELAY_TLS_PORT=465
SMTP_RELAY_USERNAME=nani

# --- Transactional email (apps/api/.env) ---
# Moderation notices + API-key location alerts. Any SMTP backend (e.g. AWS SES
# SMTP). Leave MAIL_HOST unset to log emails instead of sending them.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Nani DNS <no-reply@nani.dns>

# --- AWS SES (apps/api/.env) — multi-tenant sending via SES API ---
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
AWS_REGION=eu-north-1
SES_EVENT_WEBHOOK_SECRET=
# Development only. Production always verifies TLS certificates.
SMTP_ALLOW_INSECURE_TLS=false
