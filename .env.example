# ----------------------------------------------------------------------------
# Solucien DNS Manager — environment reference
# Copy to `.env` and fill in. Per-app files: apps/web/.env.local, apps/api/.env
# ----------------------------------------------------------------------------

# --- Auth.js (web) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Web -> API ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- API ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- PostgreSQL (Prisma) ---
DATABASE_URL=postgresql://sdm:sdm@localhost:5432/sdm?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- PowerDNS Authoritative HTTP API ---
PDNS_API_URL=http://localhost:8081
# Generate with: openssl rand -hex 24
PDNS_API_KEY=
PDNS_SERVER_ID=localhost
