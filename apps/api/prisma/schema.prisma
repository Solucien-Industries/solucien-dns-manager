// Solucien DNS Manager — data model
// Postgres is the system of record for tenants, users, domains and records.
// PowerDNS holds the authoritative zone data; the API keeps both in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DomainStatus {
  Active
  Pending
  Attention
}

enum RecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

/// A customer workspace. Everything is scoped to a tenant (multi-tenancy).
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  users     User[]
  domains   Domain[]
  apiKeys   ApiKey[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An authenticated user. Credentials come from Auth.js (OAuth) on the web side;
/// the API issues its own JWTs for service-to-service and session validation.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  role         UserRole @default(MEMBER)
  provider     String?  // e.g. "google" | "github"
  passwordHash String?  // optional local credential (mostly OAuth-only)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  apiKeys      ApiKey[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

/// Programmatic access key for automation (hashed at rest).
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  keyHash    String    @unique
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
}

/// A managed domain / PowerDNS zone.
model Domain {
  id          String       @id @default(cuid())
  name        String       @unique
  tld         String
  zone        String       @unique // PowerDNS canonical zone, e.g. "solucien.cd."
  status      DomainStatus @default(Pending)
  owner       String
  nameservers String[]     @default(["ns1.nani.dns", "ns2.nani.dns"])
  uptime      String       @default("Pending")
  lastSyncAt  DateTime?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  records     DnsRecord[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
}

/// A single DNS record belonging to a domain/zone.
model DnsRecord {
  id        String     @id @default(cuid())
  type      RecordType
  name      String // relative name, "@" for apex
  value     String
  ttl       Int        @default(300)
  priority  Int? // used by MX
  domain    Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([domainId])
}
