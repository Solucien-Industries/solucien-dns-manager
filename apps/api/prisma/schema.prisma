// Solucien DNS Manager — data model
// Postgres is the system of record for tenants, users, domains and records.
// PowerDNS holds the authoritative zone data; the API keeps both in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DomainStatus {
  Active
  Pending
  Attention
}

/// Sending (SMTP) verification lifecycle for a Domain. Separate from
/// DomainStatus above, which describes the hosted PowerDNS zone's health.
enum SendingVerificationStatus {
  PENDING_VERIFICATION
  VERIFYING
  VERIFIED
  FAILED
}

enum DomainOperationalStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum DnsVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum SmtpCredentialStatus {
  ACTIVE
  DISABLED
  REVOKED
}

/// Lifecycle of a submitted message. QUEUED means "we durably own it" — never
/// that a recipient received it.
enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  DEFERRED
  BOUNCED
  COMPLAINED
  FAILED
}

enum EmailEventType {
  QUEUED
  SENT
  DELIVERED
  DEFERRED
  BOUNCED
  COMPLAINED
  OPENED
  CLICKED
  FAILED
}

enum RecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

/// Moderation state for an account. `status` is a denormalized fast-path cache
/// used on every login; ModerationEvent is the source-of-truth history.
enum UserStatus {
  ACTIVE
  WARNED
  SUSPENDED
  BANNED
}

enum ModerationAction {
  WARN
  SUSPEND
  BAN
  UNSUSPEND
  UNBAN
}

enum NotificationKind {
  WARNING
  SUSPENSION
  BAN
  API_KEY_LOCATION
  LOGIN_LOCATION
}

enum LocationRuleType {
  CIDR
  COUNTRY
}

/// A customer workspace. Everything is scoped to a tenant (multi-tenancy).
model Tenant {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  users             User[]
  domains           Domain[]
  apiKeys           ApiKey[]
  approvedLocations ApprovedLocation[]
  smtpCredentials   SmtpCredential[]
  emailMessages     EmailMessage[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  webhooks          Webhook[]
}

/// An authenticated user. Credentials come from Auth.js (OAuth) on the web side;
/// the API issues its own JWTs for service-to-service and session validation.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  accountNumber String?
  creditCardId  String?
  image        String?
  role         UserRole   @default(MEMBER)
  provider     String?    // e.g. "google" | "github"
  passwordHash String?    // optional local credential (mostly OAuth-only)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  apiKeys      ApiKey[]

  // Moderation state (see UserStatus). `status` is the fast-path check on login;
  // ModerationEvent holds the full audit trail.
  status          UserStatus @default(ACTIVE)
  statusReason    String?
  suspendedUntil  DateTime? // null while SUSPENDED = indefinite
  statusUpdatedAt DateTime?

  smtpCredentials     SmtpCredential[]  @relation("SmtpCredentialCreator")
  moderationsReceived ModerationEvent[] @relation("ModerationTarget")
  moderationsIssued   ModerationEvent[] @relation("ModerationActor")
  notifications       Notification[]
  loginEvents         LoginEvent[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tenantId])
  @@index([accountNumber])
  @@index([creditCardId])
}

/// Programmatic access key for automation (hashed at rest).
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  keyHash    String    @unique
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
}

/// A managed domain / PowerDNS zone.
model Domain {
  id          String       @id @default(cuid())
  name        String       @unique
  tld         String
  zone        String       @unique // PowerDNS canonical zone, e.g. "solucien.cd."
  status      DomainStatus @default(Pending)
  owner       String
  nameservers String[]     @default(["ns1.nani.dns", "ns2.nani.dns"])
  uptime      String       @default("Pending")
  lastSyncAt  DateTime?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  records     DnsRecord[]

  // --- SMTP sending state (see SendingVerificationStatus / DomainOperationalStatus).
  // A Domain is both a hosted zone and, once verified, a sending identity.
  sendingVerification     SendingVerificationStatus @default(PENDING_VERIFICATION)
  operationalStatus       DomainOperationalStatus   @default(ACTIVE)
  verificationCheckedAt   DateTime?
  verificationFailureCode String?
  verifiedAt              DateTime?
  suspensionReason        String?
  returnPathHost          String? // e.g. "bounce.mail.example.com"; falls back to SMTP_BOUNCE_HOST
  smtpCredentials         SmtpCredential[]
  emailMessages           EmailMessage[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@index([sendingVerification])
}

/// A single DNS record belonging to a domain/zone.
model DnsRecord {
  id        String     @id @default(cuid())
  type      RecordType
  name      String // relative name, "@" for apex
  value     String
  ttl       Int        @default(300)
  priority  Int? // used by MX
  domain    Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId  String

  // --- Per-record sending verification (story 3).
  requiredForSending Boolean               @default(false)
  verificationStatus DnsVerificationStatus @default(PENDING)
  lastCheckedAt      DateTime?
  failureCode        String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([domainId])
}

/// Audit trail of moderation actions taken against a user (warn/suspend/ban…).
model ModerationEvent {
  id        String           @id @default(cuid())
  action    ModerationAction
  reason    String
  target    User             @relation("ModerationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  targetId  String
  actor     User?            @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  expiresAt DateTime? // set for SUSPEND
  createdAt DateTime         @default(now())

  @@index([targetId])
}

/// Persisted in-app alert shown to a user (warnings, suspensions, API-key location notices).
model Notification {
  id        String           @id @default(cuid())
  kind      NotificationKind
  title     String
  body      String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tenantId  String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([tenantId])
}

/// Where and when a user logged in (or was blocked). Powers the admin login map.
model LoginEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tenantId  String
  ip        String
  country   String?
  region    String?
  city      String?
  userAgent String?
  outcome   String // "SUCCESS" | "BLOCKED_SUSPENDED" | "BLOCKED_BANNED"
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([createdAt])
}

/// Audit of authenticated API activity. Intentionally FK-free so rows survive
/// user deletion and never fail to write for ephemeral/unknown principals.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  tenantId   String?
  method     String
  path       String
  statusCode Int
  ip         String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// A pending grant of platform ADMIN access for an email that hasn't signed in
/// yet. Created by an existing admin (see AdminController); consumed (deleted)
/// the moment that email's first login provisions its User record.
model AdminInvite {
  id          String   @id @default(cuid())
  email       String   @unique
  invitedById String?
  createdAt   DateTime @default(now())
}

/// A tenant's pre-approved location rule for API-key usage (a CIDR range or an
/// ISO-3166 alpha-2 country code). No rules configured = enforcement disabled.
model ApprovedLocation {
  id        String           @id @default(cuid())
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  type      LocationRuleType
  value     String // "203.0.113.0/24" or "CD"
  label     String?
  createdAt DateTime         @default(now())

  @@index([tenantId])
}

/// Records each time an API key is used from outside the tenant's approved
/// locations (approved=false), plus a sampling of approved use. FK-free by design.
model ApiKeyUsageEvent {
  id        String   @id @default(cuid())
  apiKeyId  String
  tenantId  String
  ip        String
  country   String?
  approved  Boolean
  path      String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([apiKeyId])
}


// ============================================================================
// SMTP transactional email
//
// Reconstructed from migration 20260813193000_smtp_transactional_email, which
// created these tables but was never reflected back into this schema — which is
// why `sender-authorization.ts` imports Prisma types that did not exist.
//
// Story 8 (accept and queue an SMTP message) adds the raw-MIME fields marked
// below. Everything else matches the original migration.
// ============================================================================

/// SMTP AUTH credential. Secrets are high-entropy and platform-generated, so a
/// single SHA-256 is an adequate verifier and stays fast enough to run on every
/// AUTH command.
model SmtpCredential {
  id          String               @id @default(cuid())
  name        String
  username    String               @unique
  prefix      String
  secretHash  String               @unique
  status      SmtpCredentialStatus @default(ACTIVE)

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  domain      Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  domainId    String? // null = workspace-scoped, set = domain-scoped
  createdBy   User    @relation("SmtpCredentialCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String

  lastUsedAt  DateTime?
  lastUsedIp  String?
  revokedAt   DateTime?
  rotatedAt   DateTime?

  messages    EmailMessage[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([domainId])
  @@index([createdById])
}

/// One submitted message, from either the REST API or the SMTP relay.
model EmailMessage {
  id                String  @id @default(cuid())
  tenant            Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId          String
  domain            Domain  @relation(fields: [domainId], references: [id])
  domainId          String
  credential        SmtpCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  credentialId      String?

  providerMessageId String? @unique
  headerFrom        String  // RFC 5322 From — what the recipient sees
  envelopeFrom      String? // platform return-path, for bounce processing
  recipients        String[]
  /// Nullable: an SMTP submission may legitimately carry no Subject header.
  subject           String?
  replyTo           String?

  // --- API-submitted bodies. Null for SMTP submissions, which carry raw MIME.
  contentText       String?
  contentHtml       String?

  // --- Story 8: SMTP submission fields --------------------------------------
  /// SMTP = relay submission, API = REST submission. Decides whether the
  /// delivery worker reads `raw` or reconstructs from contentText/contentHtml.
  source            MessageSource @default(API)
  /// What the client actually sent in MAIL FROM, before we rewrote it.
  submittedMailFrom String?
  headerFromName    String?
  messageIdHeader   String?
  sizeBytes         Int?
  remoteIp          String?
  sessionId         String?
  raw               EmailMessageBlob?
  // --------------------------------------------------------------------------

  status              MessageStatus @default(QUEUED)
  attempts            Int           @default(0)
  nextAttemptAt       DateTime      @default(now())
  processingStartedAt DateTime?
  failureReason       String?
  sentAt              DateTime?

  events    EmailEvent[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([domainId])
  @@index([credentialId])
  @@index([status, nextAttemptAt])
}

enum MessageSource {
  API
  SMTP
}

/// Story 8. Raw MIME exactly as received, in its own table so log queries never
/// drag megabytes of body through Postgres.
///
/// Byte-identical storage is not optional: DKIM signs the original bytes, so
/// reconstructing a message from parsed fields produces a signature over
/// different bytes than the ones sent, and every recipient fails verification.
/// This is also the only place attachments, custom headers and multipart
/// structure survive — contentText/contentHtml cannot represent them.
model EmailMessageBlob {
  messageId String       @id
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mime      Bytes
  createdAt DateTime     @default(now())
}

model EmailEvent {
  id              String       @id @default(cuid())
  message         EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId       String
  /// Nullable: events we generate ourselves (QUEUED at intake) have no upstream
  /// provider id. Postgres permits many NULLs under a unique index, so provider
  /// events stay deduplicated.
  providerEventId String?      @unique
  type            EmailEventType
  details         Json?
  occurredAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@index([messageId, occurredAt])
}

/// Customer-registered endpoint for delivery event notifications (story 10).
model Webhook {
  id              String    @id @default(cuid())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String
  url             String
  events          String[]
  secret          String
  active          Boolean   @default(true)
  lastDeliveredAt DateTime?
  lastStatus      Int?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, active])
}

/// Security-relevant actions on credentials and domains (story 11).
///
/// Separate from ActivityLog, which records HTTP requests — this records what
/// was done and by whom, and must remain readable long after the request that
/// caused it has scrolled out of the request log.
model SecurityAuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}