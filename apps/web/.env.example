# Copy to `.env.local` in this directory (apps/web/.env.local)

# --- Auth.js session ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- OAuth providers (configure at least one for Google/GitHub sign-in) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Web server -> API login exchange ---
# Must match AUTH_EXCHANGE_SECRET in apps/api/.env
# Generate with: openssl rand -base64 32
AUTH_EXCHANGE_SECRET=

# --- API base URL (public, used by the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
