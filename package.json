{
  "name": "solucien-dns-manager",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "npm run test --workspaces --if-present",
    "start": "npm --workspace @solucien/api run start",
    "start:api": "npm --workspace @solucien/api run start"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "next": "^16.2.10"
  }
}
